rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'goodgiftdigital@gmail.com' ||
        request.auth.token.email == 'bethelincovibetv@gmail.com' ||
        request.auth.token.email == 'bethelgoodgift3@gmail.com' ||
        request.auth.token.email == 'bethelchukwunyere1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /chats/{chatId} {
      allow get, list: if isSignedIn() && isValidId(chatId);
      allow create: if isSignedIn() && isValidId(chatId) && incoming().participants is list && incoming().participants.size() >= 1;
      allow update: if isSignedIn() && isValidId(chatId);
      allow delete: if isSignedIn() && isValidId(chatId);

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(chatId);
        allow create: if isSignedIn() && isValidId(chatId) && isValidId(messageId) && incoming().senderId is string && incoming().chatId == chatId;
        allow update: if isSignedIn() && isValidId(chatId) && isValidId(messageId);
        allow delete: if isSignedIn() && isValidId(chatId) && isValidId(messageId);
      }

      match /typing/{userId} {
        allow read, write: if isSignedIn() && isValidId(chatId);
      }
    }

    // WebRTC signaling. Media never passes through Firestore; only short-lived
    // call metadata, SDP offers/answers, and ICE candidates are signaled here.
    match /calls/{callId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().callerId is string
        && incoming().participantIds is list
        && incoming().participantIds.size() >= 1
        && incoming().kind in ['voice', 'video']
        && incoming().state == 'ringing';
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      match /peers/{peerId} {
        allow get, list, create, update: if isSignedIn();
        match /candidates/{candidateId} {
          allow get, list, create: if isSignedIn();
        }
      }
    }

    match /presence/{userId} {
      allow read, write: if isSignedIn();
    }

    match /test/connection {
      allow read, write: if true;
    }
  }
}
