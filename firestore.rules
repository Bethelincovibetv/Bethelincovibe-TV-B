rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'goodgiftdigital@gmail.com' ||
        request.auth.token.email == 'bethelincovibetv@gmail.com' ||
        request.auth.token.email == 'bethelgoodgift3@gmail.com' ||
        request.auth.token.email == 'bethelchukwunyere1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Chat Rooms
    match /chats/{chatId} {
      allow get, list: if isSignedIn() && isValidId(chatId);

      allow create: if isSignedIn()
        && isValidId(chatId)
        && incoming().participants is list
        && incoming().participants.size() >= 1;

      allow update: if isSignedIn() && isValidId(chatId);

      allow delete: if isSignedIn() && isValidId(chatId);

      // Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(chatId);

        allow create: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId)
          && incoming().senderId is string
          && incoming().chatId == chatId;

        allow update: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId);

        allow delete: if isSignedIn()
          && isValidId(chatId)
          && isValidId(messageId);
      }

      // Typing Subcollection
      match /typing/{userId} {
        allow read, write: if isSignedIn() && isValidId(chatId);
      }
    }

    // Global User Presence
    match /presence/{userId} {
      allow read, write: if isSignedIn();
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }
  }
}

